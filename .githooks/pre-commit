#!/bin/sh
# Refuse staged diffs that look like secrets or local filesystem leaks.
# Patterns are split so this file does not match itself.
set -eu

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  exit 0
fi

DIFF=$(git diff --cached -U0 --no-color)

if [ -z "$DIFF" ]; then
  exit 0
fi

PRIV_PAT="BEGIN .{0,32}PRIVAT[E] KEY"
BEARER_PAT="Bear[e]r "
DRIVE_PAT="(^|[^A-Za-z0-9])[A-Za-z]:[\\\\/]"

fail=0
if printf '%s\n' "$DIFF" | grep -E "$PRIV_PAT" >/dev/null 2>&1; then
  echo "pre-commit: staged diff looks like a private key header" >&2
  fail=1
fi
if printf '%s\n' "$DIFF" | grep -E "$BEARER_PAT" >/dev/null 2>&1; then
  echo "pre-commit: staged diff contains an authorization token" >&2
  fail=1
fi
if printf '%s\n' "$DIFF" | grep -E "$DRIVE_PAT" >/dev/null 2>&1; then
  echo "pre-commit: staged diff contains a drive-letter path" >&2
  fail=1
fi

exit "$fail"
